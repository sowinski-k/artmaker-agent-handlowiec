# Wyklucz z obrazu Docker - mniej do COPY, szybszy build, mniejszy image.

# Python
__pycache__/
*.py[cod]
*.so
.Python
*.egg-info/

# Virtual environments (build je instaluje świeżo w obrazie)
.venv/
venv/
env/
ENV/

# Local secrets - Railway dostaje je z env vars w UI, nie z pliku
.env
.env.*
secrets.env

# Streamlit secrets - to z .streamlit/secrets.toml dla local dev
.streamlit/secrets.toml

# Local DB / logs - volume Railway zamontuje świeży /app/data
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
logs/
*.log

# Kill switch - lokalny
STOP.txt

# Git (Railway build z Github, kontekst już ma historię)
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Dev / docs - nie potrzebne w runtime
README.md
deploy/install.sh
deploy/update.sh
deploy/nginx.conf
deploy/artmaker.service
.github/

# Tests (jeśli kiedyś będą)
tests/
test_*.py
*_test.py
.pytest_cache/
.coverage
htmlcov/
