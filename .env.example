# ----- Anthropic (research + draft generation) -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ----- Woodpecker (cold email delivery) -----
# API key is part of the paid "API keys & integrations" add-on.
WOODPECKER_API_KEY=
# ID of the campaign created in Woodpecker UI to which approved drafts are pushed.
WOODPECKER_CAMPAIGN_ID=

# ----- Lead sourcing -----
GOOGLE_MAPS_API_KEY=

# ----- Owner identity (used in email signatures) -----
OWNER_NAME=
OWNER_TITLE=właściciel
COMPANY_NAME=Artmaker
COMPANY_WEBSITE=

# ----- Operational guardrails -----
# DRY_RUN=true means no outbound calls (Woodpecker push, etc.). Keep on while iterating.
DRY_RUN=true
DAILY_EMAIL_LIMIT=30
DAILY_API_BUDGET_USD=10
LOG_LEVEL=INFO

# Path is resolved relative to project root.
DB_PATH=data/leads.db
