# ----- LLM provider selection -----
# Which provider to use by default for research/generation.
# Options: anthropic | gemini
# (Można też nadpisać na bieżąco z panelu w GUI.)
LLM_PROVIDER=anthropic

# ----- Anthropic (Claude) -----
ANTHROPIC_API_KEY=
# Default Claude model when LLM_PROVIDER=anthropic.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----- Google Gemini -----
GEMINI_API_KEY=
# Default Gemini model when LLM_PROVIDER=gemini.
GEMINI_MODEL=gemini-3.1-pro-preview

# ----- Woodpecker (cold email delivery) -----
# API key is part of the paid "API keys & integrations" add-on.
WOODPECKER_API_KEY=
# ID of the campaign created in Woodpecker UI to which approved drafts are pushed.
WOODPECKER_CAMPAIGN_ID=

# ----- Lead sourcing -----
GOOGLE_MAPS_API_KEY=

# ----- Owner identity (used in email signatures) -----
OWNER_NAME=
OWNER_TITLE=właściciel
COMPANY_NAME=Artmaker
COMPANY_WEBSITE=

# ----- Operational guardrails -----
# DRY_RUN=true means no outbound calls (Woodpecker push, etc.). Keep on while iterating.
DRY_RUN=true
DAILY_EMAIL_LIMIT=30
DAILY_API_BUDGET_USD=10
LOG_LEVEL=INFO

# Path is resolved relative to project root.
DB_PATH=data/leads.db
